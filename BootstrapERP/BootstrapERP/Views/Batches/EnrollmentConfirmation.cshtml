@{
    ViewBag.Title = "Enrollment Confirmation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Confirmation Section -->
<section class="confirmation-section py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="confirmation-card text-center p-5 rounded shadow-lg">
                    <!-- Success Icon -->
                    <div class="success-icon mb-4">
                        <i class="fas fa-check-circle" style="font-size: 80px; color: #28a745;"></i>
                    </div>

                    <!-- Title -->
                    <h2 class="mb-3" style="color: #333;">Enrollment Successful!</h2>

                    <!-- Message -->
                    <p class="lead mb-4" style="color: #666;">
                        Thank you for enrolling! Your enrollment has been confirmed.
                    </p>

                    <!-- Details Box -->
                    <div class="details-box p-3 mb-4" style="background: #f8f9fa; border-left: 4px solid #667eea;">
                        <p class="mb-2">
                            <strong>Enrollment ID:</strong>
                            <br />
                            <span style="font-family: monospace; color: #667eea;">#@ViewBag.EnrollmentID</span>
                        </p>
                    </div>

                    <!-- Next Steps -->
                    <div class="next-steps mb-4 p-3" style="background: #e7f3ff; border-radius: 5px;">
                        <h5 class="mb-3">What's Next?</h5>
                        <ul class="list-unstyled" style="text-align: left;">
                            <li class="mb-2">
                                <i class="fas fa-envelope" style="color: #667eea;"></i>
                                <strong>Check Your Email:</strong> A confirmation email has been sent to your registered email address.
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-book" style="color: #667eea;"></i>
                                <strong>Access Materials:</strong> You'll receive course materials before the batch starts.
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-video" style="color: #667eea;"></i>
                                <strong>Join Live Classes:</strong> Attend the live sessions on the scheduled dates.
                            </li>
                            <li>
                                <i class="fas fa-certificate" style="color: #667eea;"></i>
                                <strong>Get Certificate:</strong> Receive a certificate upon completion.
                            </li>
                        </ul>
                    </div>

                    <!-- Contact Info -->
                    <div class="contact-info p-3 mb-4" style="background: #fff3cd; border-radius: 5px;">
                        <p class="mb-0">
                            <strong>Need Help?</strong>
                            <br />
                            <small>Contact us at support@alltimestudy.com or call +880-XXXXXXXXX</small>
                        </p>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2 justify-content-center flex-wrap">
                        <a href="@Url.Action("Index", "Batches")" class="btn btn-primary btn-lg">
                            <i class="fas fa-list me-2"></i>View All Batches
                        </a>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary btn-lg">
                            <i class="fas fa-home me-2"></i>Back to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .confirmation-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
    }

    .confirmation-card {
        background: white;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    }

    .success-icon {
        animation: scaleIn 0.6s ease-in-out;
    }

    @keyframes scaleIn {
        from {
            transform: scale(0);
            opacity: 0;
        }
        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .details-box {
        border-radius: 5px;
    }

    .btn-lg {
        padding: 0.75rem 2rem;
        font-weight: 500;
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(102, 126, 234, 0.4);
    }

    @media (max-width: 576px) {
        .confirmation-section {
            padding: 2rem 0;
        }

        .d-flex.gap-2 {
            flex-direction: column;
        }

        .btn-lg {
            width: 100%;
        }

        .success-icon i {
            font-size: 60px !important;
        }
    }
</style>
