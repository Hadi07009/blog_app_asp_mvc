@{
    ViewBag.Title = "Home | AllTimeStudy - Complete Learning Platform";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Hero Section -->
<section class="hero-section py-5">
    <div class="container">
        <div class="row align-items-center" style="padding:10px;min-height: 70vh; align-items: center;">
            <!-- Left Content -->
            <div class="col-lg-6 col-md-12 mb-4 mb-lg-0">
                <p class="hero-subtitle text-muted mb-4">
                    <h1 class="hero-title mb-3">
                        Learn In-Demand Skills. <br>
                        Build Real Projects.<br>
                        <span class="text-primary"> Launch Your Tech Career.</span>
                    </h1>
                    </p>
                <p class="hero-subtitle text-muted mb-4">
                    <h3>
                        From HSC ICT to Professional Software Engineering.<br>
                        Project-based Learning for <span class="text-primary">Your Future Tech Career.</span>
                    </h3>
                </p>

                <!-- Features List -->
                <div class="row mb-4">
                    <div class="col-md-6 mb-3">
                        <div class="d-flex align-items-start">
                            <i class="fas fa-check-circle text-primary me-3 mt-1"></i>
                            <span>Live Classes</span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="d-flex align-items-start">
                            <i class="fas fa-check-circle text-primary me-3 mt-1"></i>
                            <span>Recorded Courses</span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="d-flex align-items-start">
                            <i class="fas fa-check-circle text-primary me-3 mt-1"></i>
                            <span>Real Project Based Learning</span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="d-flex align-items-start">
                            <i class="fas fa-check-circle text-primary me-3 mt-1"></i>
                            <span>Career Guidance</span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="d-flex align-items-start">
                            <i class="fas fa-check-circle text-primary me-3 mt-1"></i>
                            <span>Industry Mentorship</span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="d-flex align-items-start">
                            <i class="fas fa-check-circle text-primary me-3 mt-1"></i>
                            <span>Certificate of Completion</span>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex gap-3 flex-wrap" style="padding-top:15px">
                    <a href="@Url.Action("Index", "Contact")" class="btn btn-primary btn-lg">
                        <i class="fas fa-play-circle me-2"></i>Start Learning Today
                    </a>
                    <a href="@Url.Action("Index", "Contact")" class="btn btn-info btn-lg">
                        Become a Software Engineer
                    </a>
                </div>
            </div>

            <!-- Right Image/Illustration -->
            <div class="col-lg-6 col-md-12 text-center d-flex align-items-center justify-content-between">
                <div class="hero-image text-center">
                    <img src="~/images/hero-illustration.png" alt="Student Learning" class="img-fluid" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="stats-section py-5 bg-light">
    <div class="container">
        <div class="row text-center">
            <div class="col-md-3 col-sm-6 mb-4">
                <div class="stat-card">
                    <h3 class="stat-number text-primary">14+</h3>
                    <p class="stat-label">Years of Software Engineering Experience</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 mb-4">
                <div class="stat-card">
                    <h3 class="stat-number text-primary">Project-Based</h3>
                    <p class="stat-label">Practical Learning</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 mb-4">
                <div class="stat-card">
                    <h3 class="stat-number text-primary">Industry-Focused</h3>
                    <p class="stat-label">Skills & Technologies</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 mb-4">
                <div class="stat-card">
                    <h3 class="stat-number text-primary">Expert-Led</h3>
                    <p class="stat-label">Guidance & Mentorship</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Upcoming Batches Section -->
<section class="upcoming-batches py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <h2>Upcoming Live Batches</h2>
            <a href="@Url.Action("Index", "LiveBatches")" class="text-primary">View All Batches →</a>
        </div>

        <div class="row">
            <!-- Batch Card 1 -->
            <div class="col-lg-6 col-md-12 mb-4">
                <div class="batch-card p-4 rounded shadow-sm green border-success" style="padding:10px">
                    <div class="row align-items-center">
                        <div class="col-md-7">
                            <h3 class="mb-3">HSC 27 অনলাইন ব্যাচ আইসিটি</h3>
                            <ul class="list-unstyled small">
                                <li class="mb-2"><i class="fas fa-calendar-alt me-2 text-success"></i>Start Date: 26 September 2026</li>
                                <li class="mb-2"><i class="fas fa-hourglass-half me-2 text-success"></i>Duration: 3 Months</li>
                                <li class="mb-2"><i class="fas fa-users me-2 text-success"></i>Classes: 24 Live Sessions</li>
                                <li class="mb-2"><i class="fas fa-chair me-2 text-success"></i>Seats: 100 Students</li>
                            </ul>
                            <a href="@Url.Action("Index", "Contact")" class="btn btn-success btn-sm">
                                Reserve Your Seat
                            </a>
                        </div>
                        <div class="col-md-5 text-center">
                            @*<img src="~/images/batch-illustration-1.png" alt="Batch" class="img-fluid" />*@
                        </div>
                    </div>
                </div>
            </div>

            <!-- Batch Card 2 -->
            <div class="col-lg-6 col-md-12 mb-4">
                <div class="batch-card p-4 rounded shadow-sm border-primary" style="padding:10px">
                    <div class="row align-items-center">
                        <div class="col-md-7">
                            <h3 class="mb-3">Professional Software Engineering with ASP.NET Core, SQL Server & Oracle</h3>
                            <ul class="list-unstyled small">
                                <li class="mb-2"><i class="fas fa-calendar-alt me-2 text-primary"></i>Start Date: 17 September 2026</li>
                                <li class="mb-2"><i class="fas fa-hourglass-half me-2 text-primary"></i>Duration: 4 Months</li>
                                <li class="mb-2"><i class="fas fa-users me-2 text-primary"></i>Classes: 30+ Live Sessions</li>
                                <li class="mb-2"><i class="fas fa-chair me-2 text-primary"></i>Seats: 60 Students</li>
                            </ul>
                            <a href="@Url.Action("Index", "Contact")" class="btn btn-primary btn-sm">
                                Reserve Your Seat
                            </a>
                        </div>
                        <div class="col-md-5 text-center">
                            @*<img src="~/images/batch-illustration-2.png" alt="Batch" class="img-fluid" />*@
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Courses Section -->
<section class="featured-courses py-5 bg-light" style="display:none">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <h2>Featured Courses</h2>
            <a href="@Url.Action("", "")" class="text-primary">View All Courses →</a>
        </div>

        <div class="row">
            <!-- Course Card 1 -->
            <div class="col-lg-3 col-md-6 col-sm-12 mb-4">
                <div class="course-card rounded shadow-sm overflow-hidden">
                    <div class="course-header bg-primary text-white p-3" style="padding:10px">
                        <h6>ASP.NET MVC</h6>
                        <p class="mb-0 small">Complete Course</p>
                    </div>
                    <div class="course-body p-3" style="padding:10px">
                        <div class="mb-2">
                            <i class="fas fa-star text-warning"></i>
                            <span class="ms-1">4.8 (128)</span>
                        </div>
                        <p class="small mb-3">Learn ASP.NET MVC from basics to advanced with real-world projects.</p>
                        <h5 class="text-primary">৳ 2,999</h5>
                        <a href="@Url.Action("", "")" class="btn btn-sm btn-primary w-100">
                            View Course
                        </a>
                    </div>
                </div>
            </div>

            <!-- Course Card 2 -->
            <div class="col-lg-3 col-md-6 col-sm-12 mb-4">
                <div class="course-card rounded shadow-sm overflow-hidden">
                    <div class="course-header bg-info text-white p-3" style="padding:10px">
                        <h6>.NET Core</h6>
                        <p class="mb-0 small">Bootcamp</p>
                    </div>
                    <div class="course-body p-3" style="padding:10px">
                        <div class="mb-2">
                            <i class="fas fa-star text-warning"></i>
                            <span class="ms-1">4.9 (96)</span>
                        </div>
                        <p class="small mb-3">Master .NET Core development with hands-on projects and guidance.</p>
                        <h5 class="text-info">৳ 3,999</h5>
                        <a href="@Url.Action("", "")" class="btn btn-sm  btn-info w-100">
                            View Course
                        </a>
                    </div>
                </div>
            </div>

            <!-- Course Card 3 -->
            <div class="col-lg-3 col-md-6 col-sm-12 mb-4">
                <div class="course-card rounded shadow-sm overflow-hidden">
                    <div class="course-header bg-success text-white p-3" style="padding:10px">
                        <h6>Git & GitHub</h6>
                        <p class="mb-0 small">Beginner Guide</p>
                    </div>
                    <div class="course-body p-3" style="padding:10px">
                        <div class="mb-2">
                            <i class="fas fa-star text-warning"></i>
                            <span class="ms-1">4.9 (205)</span>
                        </div>
                        <p class="small mb-3">Learn version control and collaboration with Git and GitHub.</p>
                        <h5 class="text-success">FREE</h5>
                        <a href="@Url.Action("", "")" class="btn btn-sm btn-success w-100">
                            Enroll Now
                        </a>
                    </div>
                </div>
            </div>

            <!-- Course Card 4 -->
            <div class="col-lg-3 col-md-6 col-sm-12 mb-4">
                <div class="course-card rounded shadow-sm overflow-hidden">
                    <div class="course-header bg-danger text-white p-3" style="padding:10px">
                        <h6>SQL Server</h6>
                        <p class="mb-0 small">Masterclass</p>
                    </div>
                    <div class="course-body p-3" style="padding:10px">
                        <div class="mb-2">
                            <i class="fas fa-star text-warning"></i>
                            <span class="ms-1">4.7 (75)</span>
                        </div>
                        <p class="small mb-3">Database design and optimization with SQL Server expertise.</p>
                        <h5 class="text-danger">৳ 2,499</h5>
                        <a href="@Url.Action("", "")" class="btn btn-sm btn-danger w-100">
                            View Course
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

